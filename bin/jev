#!/usr/bin/env bash
# jev-cli 启动器：挑一个 >=3.9 的 python，把仓库根加进 PYTHONPATH，然后进 CLI。
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

for candidate in python3.13 python3.12 python3.11 python3.10 python3.9 "$HOME/.local/bin/python3.12" "$HOME/.local/bin/python3.11" python3; do
  if command -v "$candidate" >/dev/null 2>&1; then
    if version=$("$candidate" -c 'import sys; print("%d%d" % sys.version_info[:2])' 2>/dev/null); then
      if [ "$version" -ge 39 ]; then
        exec env PYTHONPATH="$here${PYTHONPATH:+:$PYTHONPATH}" "$candidate" -m jev "$@"
      fi
    fi
  fi
done

echo "需要 Python 3.9+（当前系统 python3 太旧）。装一个或指定 PATH 后再试。" >&2
exit 1
